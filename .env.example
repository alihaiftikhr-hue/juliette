# ─── Supabase ────────────────────────────────────────────────────────────────
# Your Supabase project URL (no trailing slash)
# Found in: Supabase Dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Your Supabase anon/public key (the long eyJ... string)
# Found in: Supabase Dashboard → Project Settings → API → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Supabase service_role key — KEEP THIS SECRET, never expose to browser!
# Found in: Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Admin ───────────────────────────────────────────────────────────────────
# Password to access the /admin panel
ADMIN_PASSWORD=your-secure-admin-password

# ─── WhatsApp ─────────────────────────────────────────────────────────────────
# WhatsApp number for cart orders (digits only, with country code, no + or spaces)
# Example: 923001234567  →  +92 300 1234567
NEXT_PUBLIC_WHATSAPP=923001234567
